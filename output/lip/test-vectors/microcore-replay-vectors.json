  "vectors": [
    {
      "id": "RP-01",
      "name": "a retry after the cap was cut is recognised and replayed; a fresh execution of the same amount would be refused",
      "steps": [
        {
          "op": "claim",
          "scope": [
            "did:key:z6MkPrincipalA",
            "did:key:z6MkAgent"
          ],
          "key": "k1",
          "identity": "pay-500",
          "expect": "reserved"
        },
        {
          "op": "complete",
          "scope": [
            "did:key:z6MkPrincipalA",
            "did:key:z6MkAgent"
          ],
          "key": "k1",
          "result": {
            "status": "paid",
            "amount": 500
          }
        },
        {
          "op": "lookup",
          "scope": [
            "did:key:z6MkPrincipalA",
            "did:key:z6MkAgent"
          ],
          "key": "k1",
          "identity": "pay-500",
          "expect": "completed",
          "expect_result": {
            "status": "paid",
            "amount": 500
          }
        },
        {
          "op": "check_invocation",
          "envelope": "pay_100_cut",
          "act": "finance:pay",
          "resource": "mcp://tools.example.com/billing/pay",
          "amount": 500,
          "unit": "USD",
          "enforce_magnitude": false,
          "expect": "ok"
        },
        {
          "op": "check_invocation",
          "envelope": "pay_100_cut",
          "act": "finance:pay",
          "resource": "mcp://tools.example.com/billing/pay",
          "amount": 500,
          "unit": "USD",
          "enforce_magnitude": true,
          "expect": "LAP_ERR_CAP"
        }
      ]
    },
