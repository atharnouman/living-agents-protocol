[0.061,"o","\u001b[33m=== LAP OVERNIGHT DEMO — two real processes, both humans asleep ===\u001b[0m\r\n"]
[0.061,"o","\r\n"]
[0.162,"o","\u001b[35m[seller] listening on http://127.0.0.1:4107  agent did:key:z6Mkob25wy2TLv…  (identity created)\u001b[0m\r\n"]
[0.251,"o","\u001b[33m[conductor]  seller is live; starting buyer as a separate process\r\n"]
[0.251,"o","\u001b[0m\r\n"]
[3.732,"o","\u001b[36m[buyer]  agent did:key:z6Mkpzd6yRwai5…  →  seller at http://127.0.0.1:4107\u001b[0m\r\n"]
[7.251,"o","\u001b[36m[buyer]  MEET HAIL/PROVE: fetched + verified seller passport did:key:z6Mkob25wy2TLv… → VERIFIED\u001b[0m\r\n"]
[7.261,"o","\u001b[35m[seller] HAIL: verified buyer passport did:key:z6Mkpzd6yRwai5… (principal did:key:z6MkhUmvTX…) → VERIFIED\u001b[0m\r\n"]
[10.669,"o","\u001b[36m[buyer]    ↕ real HTTP: sent our passport, seller replied {\"step\":\"HAIL\",\"ok\":true} (both sides verified each other's Ed25519 signatures)\u001b[0m\r\n"]
[14.072,"o","\u001b[36m[buyer]  MEET CHARTER: authorizer reservation $50 bound to seller, disclosed before transacting\u001b[0m\r\n"]
[14.091,"o","\u001b[35m[seller] BIND: countersigned interaction contract c3a3e87243…\u001b[0m\r\n"]
[17.516,"o","\u001b[36m[buyer]  MEET BIND: interaction contract dual-signed (seller countersignature verified: true) → session ACTIVE\u001b[0m\r\n"]
[17.516,"o","\u001b[36m\u001b[0m\r\n"]
[20.939,"o","\u001b[35m[seller] /pay A-001: passport✓ aud✓ signature✓ cap✓ ($36) → signed receipt returned\u001b[0m\r\n"]
[20.944,"o","\u001b[36m[buyer]  ORDER A-001: 3 units @ $12 = $36 over HTTP — receipt signature✓ ($36/$100 daily)\u001b[0m\r\n"]
[21.452,"o","\u001b[33m[conductor]  *** killing the seller process now (real SIGKILL) — simulating a crash ***\u001b[0m\r\n"]
[21.853,"o","\u001b[36m[buyer]  no pulse from seller (connection refused) — first miss\u001b[0m\r\n"]
[22.77,"o","\u001b[36m[buyer]  no pulse from seller across 2 intervals → counterparty DEGRADED, authority SUSPENDED prospectively\u001b[0m\r\n"]
[22.771,"o","\u001b[36m[buyer]  order A-002 is due — HELD: no live counterparty, nothing moves (no human woken: within protocol)\u001b[0m\r\n"]
[22.771,"o","\u001b[33m[conductor]  buyer safely held its order through the outage. Restarting the seller…\u001b[0m\r\n"]
[26.492,"o","\u001b[35m[seller] listening on http://127.0.0.1:4107  agent did:key:z6Mkob25wy2TLv…  (identity RELOADED — same DID across restart)\u001b[0m\r\n"]
[26.541,"o","\u001b[33m[conductor]  *** seller process RESTARTED and listening again — a restart is a nap, not a death ***\r\n"]
[26.541,"o","\u001b[0m\r\n"]
[27.323,"o","\u001b[36m[buyer]  pulse resumed from seller → authority restored automatically; releasing held order\u001b[0m\r\n"]
[27.331,"o","\u001b[35m[seller] /pay A-002: passport✓ aud✓ signature✓ cap✓ ($36) → signed receipt returned\u001b[0m\r\n"]
[27.334,"o","\u001b[36m[buyer]  ORDER A-002: 3 units @ $12 = $36 over HTTP — receipt signature✓ ($72/$100 daily)\u001b[0m\r\n"]
[27.337,"o","\u001b[36m[buyer]  \u001b[0m\r\n"]
[27.337,"o","\u001b[36mSession closed: 2 orders, $72 total over real HTTP, 1 suspension, 0 escalations\u001b[0m\r\n"]
[27.337,"o","\u001b[36m[buyer]  Transcript → net/out/session.json. This ran across TWO OS processes exchanging signed JSON over sockets.\u001b[0m\r\n"]
